---
import Layout from "../layouts/Layout.astro";
import ToolGrid from "../components/tool/ToolGrid.tsx";
import BgRemovalDemo from "../components/site/BgRemovalDemo.tsx";
import HeroCaptionReel from "../components/site/HeroCaptionReel.tsx";
import ToolShowcaseGrid from "../components/site/ToolShowcaseGrid.tsx";
import { tools } from "../lib/tools-registry";
import {
  ShieldCheck,
  Zap,
  Download,
  Sparkles,
  Camera,
  UploadCloud,
  Wand2,
  Layers,
  ShoppingBag,
  Users,
  Clapperboard,
  GraduationCap,
} from "lucide-react";

const featuredTools = tools.filter((t) => t.featured);
const stats = [
  { value: `${tools.length}`, label: "tools, one app" },
  { value: "0", label: "files ever uploaded" },
  { value: "100%", label: "runs in your browser" },
];

const aiSteps = [
  { icon: UploadCloud, title: "Drop in your clip or photo", description: "Any background — a messy room, an office, the outdoors. No backdrop required." },
  { icon: Sparkles, title: "AI finds the subject", description: "An on-device segmentation model detects the person automatically — no green screen involved." },
  { icon: Layers, title: "Pick a new background", description: "Transparent, a solid color, a blurred version of the original, or your own image or video." },
];

const examples = [
  {
    icon: ShoppingBag,
    title: "Product demos",
    description: "Swap a cluttered desk for a clean studio backdrop so the product stays the focus.",
  },
  {
    icon: Users,
    title: "Video calls & recordings",
    description: "Blur or replace a home office background before sharing a recorded call.",
  },
  {
    icon: Sparkles,
    title: "Social clips & reels",
    description: "Drop a bold color or scene behind you for thumb-stopping short-form clips.",
  },
  {
    icon: GraduationCap,
    title: "Tutorials & live streams",
    description: "Keep viewers focused on you and the screen, not on what's behind you.",
  },
];
---

<Layout>
  <section class="relative overflow-hidden">
    <div
      class="pointer-events-none absolute inset-0 -z-10 bg-[radial-gradient(ellipse_at_top,_var(--tw-gradient-stops))] from-primary-100 via-transparent to-transparent dark:from-primary-950/40"
    >
    </div>
    <div
      class="pointer-events-none absolute -right-24 top-24 -z-10 h-96 w-96 rounded-full bg-accent-400/20 blur-3xl dark:bg-accent-500/10"
    >
    </div>
    <div class="mx-auto max-w-7xl px-4 pb-16 pt-16 sm:px-6 sm:pb-24 sm:pt-24 lg:px-8">
      <div class="grid grid-cols-1 items-center gap-12 lg:grid-cols-[1.1fr_0.9fr] lg:gap-8">
        <div class="mx-auto max-w-2xl text-center lg:mx-0 lg:max-w-none lg:text-left">
          <span
            class="inline-flex items-center gap-1.5 rounded-full border border-(--color-border) bg-(--color-surface) px-3 py-1 text-caption font-medium text-(--color-text-muted)"
          >
            <ShieldCheck size={14} className="text-success-500" />
            No uploads &mdash; everything processes on your device
          </span>
          <h1 class="mt-6 text-h1 font-bold tracking-tight text-balance sm:text-display">
            A full video editor, <span class="text-primary-500">right in your browser.</span>
          </h1>
          <p class="mt-5 text-subheading text-(--color-text-muted) text-balance">
            Trim, caption, remove backgrounds, upscale, dub, and export — {tools.length} focused
            tools plus a full timeline editor. No installs, no watermarks, no uploads: everything
            runs on your own device.
          </p>
          <div class="mt-8 flex flex-wrap items-center justify-center gap-3 lg:justify-start">
            <a
              href="/tools/video/video-editor"
              class="inline-flex items-center rounded-md bg-primary-500 px-6 py-3 font-semibold text-white shadow-sm shadow-primary-500/30 transition-colors hover:bg-primary-600"
            >
              Start editing free
            </a>
            <a
              href="/tools"
              class="inline-flex items-center rounded-md border border-(--color-border) bg-(--color-surface) px-6 py-3 font-semibold transition-colors hover:border-(--color-border-strong)"
            >
              Browse all tools
            </a>
          </div>

          <dl class="mt-14 grid grid-cols-3 gap-4 border-t border-(--color-border) pt-8">
            {stats.map((stat) => (
              <div>
                <dt class="sr-only">{stat.label}</dt>
                <dd class="text-h2 font-bold text-primary-500">{stat.value}</dd>
                <dd class="mt-1 text-body-sm text-(--color-text-muted)">{stat.label}</dd>
              </div>
            ))}
          </dl>
        </div>

        <div class="lg:pl-6">
          <HeroCaptionReel client:load />
        </div>
      </div>
    </div>
  </section>

  <section class="mx-auto max-w-7xl px-4 pb-16 sm:px-6 lg:px-8">
    <div class="mx-auto max-w-2xl text-center">
      <h2 class="text-h3 font-bold tracking-tight">One editor, every tool you need</h2>
      <p class="mt-3 text-body-sm text-(--color-text-muted) text-balance">
        A few of the {tools.length} tools inside — each one runs the same engine you see in the
        preview above.
      </p>
    </div>
    <div class="mt-10">
      <ToolShowcaseGrid client:visible />
    </div>
  </section>

  <section class="mx-auto max-w-7xl px-4 py-16 sm:px-6 lg:px-8">
    <div class="mx-auto max-w-2xl text-center">
      <span class="inline-flex items-center gap-1.5 rounded-full bg-primary-100 px-3 py-1 text-caption font-semibold text-primary-700 dark:bg-primary-950/50 dark:text-primary-300">
        <Layers size={13} />
        Featured tool
      </span>
      <h2 class="mt-4 text-h2 font-bold tracking-tight text-balance">See background removal in action</h2>
      <p class="mt-3 text-body-sm text-(--color-text-muted) text-balance">
        Drag the handle below. This is the exact chroma-key engine the tool uses, running live in
        your browser right now — no server round trip.
      </p>
    </div>
    <div class="mx-auto mt-10 max-w-4xl">
      <BgRemovalDemo client:visible />
      <p class="mt-2 text-caption text-(--color-text-muted)">
        Photos: <a href="https://www.pexels.com/@hrutik-tidke-2148824456" class="underline hover:text-(--color-text)">Hrutik Tidke</a> and <a href="https://www.pexels.com/@cottonbro" class="underline hover:text-(--color-text)">cottonbro studio</a> via Pexels.
      </p>
    </div>
    <div class="mt-6 flex justify-center">
      <a
        href="/tools/video/remove-background"
        class="inline-flex items-center gap-2 rounded-md bg-primary-500 px-6 py-3 font-semibold text-white shadow-sm shadow-primary-500/30 transition-colors hover:bg-primary-600"
      >
        <Wand2 size={16} />
        Try it on your own video or photo
      </a>
    </div>
  </section>

  <section class="border-y border-(--color-border) bg-(--color-bg-subtle)">
    <div class="mx-auto max-w-7xl px-4 py-16 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 gap-10 lg:grid-cols-2 lg:items-center lg:gap-16">
        <div>
          <span class="inline-flex items-center gap-1.5 rounded-full border border-(--color-border) bg-(--color-surface) px-3 py-1 text-caption font-medium text-(--color-text-muted)">
            <Camera size={13} />
            No green screen footage?
          </span>
          <h2 class="mt-4 text-h3 font-bold tracking-tight text-balance">No problem — AI can find the subject on its own.</h2>
          <p class="mt-3 text-body-sm text-(--color-text-muted)">
            Most clips aren't shot in front of a green screen. Switch the tool to "No green screen
            (AI)" mode and an on-device subject-detection model finds the person for you — works
            on a photo or a talking-head clip shot anywhere.
          </p>
          <a href="/tools/video/remove-background" class="mt-5 inline-flex items-center text-body-sm font-semibold text-primary-600 hover:text-primary-700">
            Try AI background removal &rarr;
          </a>
        </div>
        <div class="grid gap-4">
          {aiSteps.map((step, i) => (
            <div class="flex items-start gap-4 rounded-xl border border-(--color-border) bg-(--color-surface) p-4">
              <span class="grid h-9 w-9 shrink-0 place-items-center rounded-lg bg-primary-100 text-primary-600 dark:bg-primary-900 dark:text-primary-300">
                <step.icon size={16} />
              </span>
              <div>
                <p class="font-semibold">
                  <span class="text-primary-500">{i + 1}.</span> {step.title}
                </p>
                <p class="mt-0.5 text-body-sm text-(--color-text-muted)">{step.description}</p>
              </div>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <section class="mx-auto max-w-7xl px-4 py-16 sm:px-6 lg:px-8">
    <div class="mx-auto max-w-2xl text-center">
      <h2 class="text-h3 font-bold tracking-tight">Video background removal examples</h2>
      <p class="mt-3 text-body-sm text-(--color-text-muted)">
        A few of the ways people use it — same tool, same two modes, any of these outcomes.
      </p>
    </div>
    <div class="mt-10 grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-4">
      {examples.map((ex) => (
        <div class="group rounded-xl border border-(--color-border) bg-(--color-surface) p-6 shadow-sm transition-all duration-300 hover:-translate-y-1 hover:border-accent-300 hover:shadow-lg hover:shadow-accent-500/10 dark:hover:border-accent-800">
          <span class="grid h-10 w-10 place-items-center rounded-lg bg-accent-100 text-accent-700 transition-transform duration-300 group-hover:scale-110 dark:bg-accent-950/50 dark:text-accent-300">
            <ex.icon size={18} />
          </span>
          <h3 class="mt-3 font-semibold">{ex.title}</h3>
          <p class="mt-1 text-body-sm text-(--color-text-muted)">{ex.description}</p>
        </div>
      ))}
    </div>
  </section>

  <section class="border-y border-(--color-border) bg-(--color-bg-subtle)">
    <div class="mx-auto max-w-7xl px-4 py-12 sm:px-6 lg:px-8">
      <div class="flex items-end justify-between gap-4">
        <div>
          <h2 class="text-h3 font-bold tracking-tight">Popular tools</h2>
          <p class="mt-1 text-body-sm text-(--color-text-muted)">
            Background removal is one of {tools.length} — here are the tools people reach for most.
          </p>
        </div>
        <a href="/tools" class="hidden shrink-0 text-body-sm font-semibold text-primary-600 hover:text-primary-700 sm:block"
          >View all &rarr;</a
        >
      </div>
      <div class="mt-6">
        <ToolGrid client:load tools={featuredTools} showSearch={false} />
      </div>
    </div>
  </section>

  <section class="mx-auto max-w-7xl px-4 py-16 sm:px-6 lg:px-8">
    <div class="mx-auto max-w-2xl text-center">
      <h2 class="text-h3 font-bold tracking-tight">Built to be fast, private, and simple</h2>
      <p class="mt-3 text-body-sm text-(--color-text-muted)">
        Most online editors upload your files to a server, make you wait, and stamp a watermark
        on the result. Clipbench does it differently.
      </p>
    </div>
    <div class="mt-10 grid grid-cols-1 gap-6 sm:grid-cols-3">
      <div class="group rounded-xl border border-(--color-border) bg-(--color-surface) p-6 shadow-sm transition-all duration-300 hover:-translate-y-1 hover:shadow-lg">
        <span class="grid h-10 w-10 place-items-center rounded-lg bg-success-500/15 text-success-600 transition-transform duration-300 group-hover:scale-110">
          <ShieldCheck size={20} />
        </span>
        <h3 class="mt-3 font-semibold">Private by design</h3>
        <p class="mt-1 text-body-sm text-(--color-text-muted)">
          Your files are processed on your own device and never uploaded to a server.
        </p>
      </div>
      <div class="group rounded-xl border border-(--color-border) bg-(--color-surface) p-6 shadow-sm transition-all duration-300 hover:-translate-y-1 hover:shadow-lg">
        <span class="grid h-10 w-10 place-items-center rounded-lg bg-primary-100 text-primary-600 transition-transform duration-300 group-hover:scale-110 dark:bg-primary-950 dark:text-primary-300">
          <Zap size={20} />
        </span>
        <h3 class="mt-3 font-semibold">No waiting in line</h3>
        <p class="mt-1 text-body-sm text-(--color-text-muted)">
          No upload queue and no server load &mdash; processing starts the second you drop a
          file.
        </p>
      </div>
      <div class="group rounded-xl border border-(--color-border) bg-(--color-surface) p-6 shadow-sm transition-all duration-300 hover:-translate-y-1 hover:shadow-lg">
        <span class="grid h-10 w-10 place-items-center rounded-lg bg-accent-100 text-accent-700 transition-transform duration-300 group-hover:scale-110 dark:bg-accent-950/50 dark:text-accent-300">
          <Download size={20} />
        </span>
        <h3 class="mt-3 font-semibold">Download or share instantly</h3>
        <p class="mt-1 text-body-sm text-(--color-text-muted)">
          Save your export locally, or send it straight to another app with one tap.
        </p>
      </div>
    </div>
  </section>

  <section class="relative mx-auto max-w-7xl overflow-hidden px-4 py-16 text-center sm:px-6 lg:px-8">
    <div
      class="pointer-events-none absolute inset-x-0 top-0 -z-10 mx-auto h-64 w-full max-w-2xl bg-[radial-gradient(ellipse_at_top,_var(--tw-gradient-stops))] from-primary-200/60 via-transparent to-transparent dark:from-primary-900/30"
    >
    </div>
    <Clapperboard className="mx-auto text-primary-500" size={28} />
    <h2 class="mt-4 text-h3 font-bold tracking-tight">Ready when you are</h2>
    <p class="mx-auto mt-2 max-w-md text-body-sm text-(--color-text-muted)">
      No sign-up required. Pick a tool and get started in seconds.
    </p>
    <a
      href="/tools"
      class="mt-6 inline-flex items-center rounded-md bg-primary-500 px-6 py-3 font-semibold text-white shadow-sm shadow-primary-500/30 transition-colors hover:bg-primary-600"
    >
      Explore all {tools.length} tools
    </a>
  </section>
</Layout>
