---
import Layout from "../../../layouts/Layout.astro";
import MattingBenchmarkPanel from "../../../components/tool/video/MattingBenchmarkPanel.tsx";
---

<Layout
  title="Matting Performance Benchmark — Clipbench"
  description="Measures the Remove Background tool's AI matting pipeline performance on this device: inference time, total processing time, peak memory, and throughput across image/video resolutions and frame rates."
>
  <div class="mx-auto max-w-[1000px] px-4 py-8 sm:px-6 lg:px-8">
    <nav class="mb-4 flex items-center gap-1.5 text-caption text-(--color-text-muted)" aria-label="Breadcrumb">
      <a href="/" class="hover:text-(--color-text)">Home</a>
      <span aria-hidden="true">/</span>
      <a href="/tools/video/remove-background" class="hover:text-(--color-text)">Remove Background</a>
      <span aria-hidden="true">/</span>
      <span class="text-(--color-text)">Performance Benchmark</span>
    </nav>
    <h1 class="mb-1 text-heading-2 font-semibold">Matting Performance Benchmark</h1>
    <p class="mb-6 text-body-sm text-(--color-text-muted)">
      An internal diagnostic tool, not listed in the main tools directory — measures the same on-device AI
      background-removal pipeline the Remove Background tool uses, so performance changes can be checked against a
      real baseline on real hardware instead of guessed at.
    </p>
    <MattingBenchmarkPanel client:load />
  </div>
</Layout>
