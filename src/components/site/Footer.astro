---
import { tools, categoryMeta, getToolPath, type ToolCategory } from "../../lib/tools-registry";

const categories = Object.keys(categoryMeta) as ToolCategory[];
---

<footer class="relative border-t border-(--color-border) bg-(--color-bg-subtle)">
  <div class="mx-auto max-w-7xl px-4 py-12 sm:px-6 lg:px-8">
    <div class="grid grid-cols-2 gap-8 md:grid-cols-4">
      <div class="col-span-2 md:col-span-1">
        <a href="/" class="flex items-center gap-2" aria-label="Clipbench home">
          <span
            class="grid h-7 w-7 place-items-center rounded-lg bg-linear-to-br from-primary-500 to-accent-500 text-white"
          >
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" aria-hidden="true">
              <path
                d="M4 6.5C4 5.12 5.12 4 6.5 4h9C16.88 4 18 5.12 18 6.5v11c0 1.38-1.12 2.5-2.5 2.5h-9A2.5 2.5 0 0 1 4 17.5v-11Z"
                fill="currentColor"
                opacity="0.9"></path>
              <path d="m20 9 3-1.6v9.2L20 15" fill="currentColor"></path>
            </svg>
          </span>
          <span class="font-semibold tracking-tight">Clipbench</span>
        </a>
        <p class="mt-3 max-w-xs text-body-sm text-(--color-text-muted)">
          Free, private video and audio editing that runs entirely in your browser. Nothing you
          upload ever leaves your device.
        </p>
      </div>

      {categories.map((category) => (
        <div>
          <h3 class="text-body-sm font-semibold">{categoryMeta[category].label}</h3>
          <ul class="mt-3 space-y-2">
            {tools
              .filter((t) => t.category === category)
              .slice(0, 6)
              .map((tool) => (
                <li>
                  <a
                    href={getToolPath(tool)}
                    class="text-body-sm text-(--color-text-muted) transition-colors hover:text-(--color-text)"
                  >
                    {tool.name}
                  </a>
                </li>
              ))}
          </ul>
        </div>
      ))}
    </div>

    <div
      class="mt-10 flex flex-col items-start justify-between gap-4 border-t border-(--color-border) pt-6 text-body-sm text-(--color-text-muted) sm:flex-row sm:items-center"
    >
      <p>&copy; {new Date().getFullYear()} Clipbench. Editing happens on your device; cloud AI features upload only what you send them. <a href="/privacy" class="underline-offset-2 hover:text-(--color-text) hover:underline">Privacy</a> · <a href="/terms" class="underline-offset-2 hover:text-(--color-text) hover:underline">Terms</a> · <a href="/licenses" class="underline-offset-2 hover:text-(--color-text) hover:underline">Licenses</a></p>
      <a href="/tools" class="font-medium text-(--color-text) hover:text-primary-600"
        >Browse all {tools.length} tools &rarr;</a
      >
    </div>
  </div>
</footer>
