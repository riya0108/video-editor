---
import { categoryMeta, type ToolCategory } from "../../lib/tools-registry";

interface Props {
  name: string;
  description: string;
  category: ToolCategory;
  /** Full header with h1 + description — only the "coming soon" placeholder page needs this; every built tool reclaims that vertical space for its own workspace and keeps just the breadcrumb. */
  showTitle?: boolean;
}

const { name, description, category, showTitle = false } = Astro.props;
---

<div class="mx-auto max-w-[1600px] px-4 py-2.5 sm:px-6 lg:px-8">
  <nav class="flex items-center gap-1.5 text-caption text-(--color-text-muted)" aria-label="Breadcrumb">
    <a href="/" class="hover:text-(--color-text)">Home</a>
    <span aria-hidden="true">/</span>
    <a href={`/tools?category=${category}`} class="hover:text-(--color-text)"
      >{categoryMeta[category].label}</a
    >
    <span aria-hidden="true">/</span>
    <span class="text-(--color-text)">{name}</span>
  </nav>
  {showTitle && (
    <>
      <h1 class="mt-2 text-h2 font-bold tracking-tight">{name}</h1>
      <p class="mt-1.5 max-w-2xl text-body-sm text-(--color-text-muted)">{description}</p>
    </>
  )}
</div>
