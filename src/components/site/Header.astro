---
---

<header
  class="sticky top-0 z-40 border-b border-(--color-border) bg-(--color-bg)/80 backdrop-blur-md"
>
  <div class="mx-auto flex h-16 max-w-7xl items-center justify-between gap-4 px-4 sm:px-6 lg:px-8">
    <a href="/" class="flex items-center gap-2 shrink-0" aria-label="Clipbench home">
      <span
        class="grid h-8 w-8 place-items-center rounded-lg bg-linear-to-br from-primary-500 to-accent-500 text-white font-bold"
      >
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true">
          <path
            d="M4 6.5C4 5.12 5.12 4 6.5 4h9C16.88 4 18 5.12 18 6.5v11c0 1.38-1.12 2.5-2.5 2.5h-9A2.5 2.5 0 0 1 4 17.5v-11Z"
            fill="currentColor"
            opacity="0.9"></path>
          <path d="m20 9 3-1.6v9.2L20 15" fill="currentColor"></path>
        </svg>
      </span>
      <span class="text-body font-semibold tracking-tight">Clipbench</span>
    </a>

    <nav class="hidden md:flex items-center gap-1 text-body-sm font-medium" aria-label="Primary">
      <a
        href="/tools?category=video"
        class="rounded-full px-3 py-2 text-(--color-text-muted) transition-colors hover:bg-(--color-bg-subtle) hover:text-(--color-text)"
        >Video Tools</a
      >
      <a
        href="/tools?category=audio"
        class="rounded-full px-3 py-2 text-(--color-text-muted) transition-colors hover:bg-(--color-bg-subtle) hover:text-(--color-text)"
        >Audio Tools</a
      >
      <a
        href="/tools/speech/text-to-speech"
        class="rounded-full px-3 py-2 text-(--color-text-muted) transition-colors hover:bg-(--color-bg-subtle) hover:text-(--color-text)"
        >Text to Speech</a
      >
      <a
        href="/tools"
        class="rounded-full px-3 py-2 text-(--color-text-muted) transition-colors hover:bg-(--color-bg-subtle) hover:text-(--color-text)"
        >All Tools</a
      >
    </nav>

    <div class="flex items-center gap-2">
      <button
        id="theme-toggle"
        type="button"
        aria-label="Toggle dark mode"
        class="grid h-9 w-9 place-items-center rounded-md text-(--color-text-muted) transition-colors hover:bg-(--color-bg-subtle) hover:text-(--color-text)"
      >
        <svg
          id="icon-sun"
          class="hidden dark:block"
          width="18"
          height="18"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
        >
          <circle cx="12" cy="12" r="4"></circle>
          <path
            d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"
          ></path>
        </svg>
        <svg
          id="icon-moon"
          class="block dark:hidden"
          width="18"
          height="18"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8Z"></path>
        </svg>
      </button>

      <a
        href="/tools"
        class="hidden sm:inline-flex items-center rounded-full bg-primary-500 px-4 py-2 text-body-sm font-semibold text-white shadow-sm transition-colors hover:bg-primary-600"
      >
        Start editing
      </a>

      <button
        id="mobile-menu-toggle"
        type="button"
        aria-label="Open menu"
        aria-expanded="false"
        class="grid h-9 w-9 place-items-center rounded-md text-(--color-text-muted) hover:bg-(--color-bg-subtle) md:hidden"
      >
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
          <path d="M3 6h18M3 12h18M3 18h18"></path>
        </svg>
      </button>
    </div>
  </div>

  <nav
    id="mobile-menu"
    class="hidden flex-col gap-1 border-t border-(--color-border) px-4 py-3 text-body-sm font-medium md:hidden"
    aria-label="Mobile"
  >
    <a href="/tools?category=video" class="rounded-md px-3 py-2 hover:bg-(--color-bg-subtle)">Video Tools</a>
    <a href="/tools?category=audio" class="rounded-md px-3 py-2 hover:bg-(--color-bg-subtle)">Audio Tools</a>
    <a href="/tools/speech/text-to-speech" class="rounded-md px-3 py-2 hover:bg-(--color-bg-subtle)">Text to Speech</a>
    <a href="/tools" class="rounded-md px-3 py-2 hover:bg-(--color-bg-subtle)">All Tools</a>
  </nav>
</header>

<script is:inline>
  (function () {
    var toggle = document.getElementById("theme-toggle");
    toggle?.addEventListener("click", function () {
      var isDark = document.documentElement.classList.contains("dark");
      document.documentElement.classList.toggle("dark", !isDark);
      document.documentElement.classList.toggle("light", isDark);
      try {
        localStorage.setItem("theme", !isDark ? "dark" : "light");
      } catch (e) {}
    });

    var menuToggle = document.getElementById("mobile-menu-toggle");
    var menu = document.getElementById("mobile-menu");
    menuToggle?.addEventListener("click", function () {
      var isOpen = menu?.classList.toggle("flex");
      menu?.classList.toggle("hidden");
      menuToggle.setAttribute("aria-expanded", String(!!isOpen));
    });
  })();
</script>
