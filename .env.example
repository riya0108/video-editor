# Stock library (Stock drawer in the video editor). Both keys are free; without them the drawer still offers
# Openverse photos and music, which need no key.
#   Pexels:  https://www.pexels.com/api/
#   Pixabay: https://pixabay.com/api/docs/
PEXELS_API_KEY=
PIXABAY_API_KEY=

# Signs the stock download proxy's links. Set it (any long random string) when running more than one server
# instance, or to keep links valid across restarts; otherwise a random secret is generated at startup.
STOCK_PROXY_SECRET=

# Features whose AI models are licensed for NON-COMMERCIAL use only: caption translation (NLLB-200), voice cloning
# (F5-TTS) and the RMBG-1.4 matting model. Leave unset (off) for any commercial deployment — including a free site
# run by a business — unless you hold commercial licenses from the model owners. See MODEL_LICENSES.md.
PUBLIC_ALLOW_NONCOMMERCIAL_MODELS=
