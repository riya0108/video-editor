# Stock library (Stock drawer in the video editor). Both keys are free; without them the drawer still offers
# Openverse photos and music, which need no key.
#   Pexels:  https://www.pexels.com/api/
#   Pixabay: https://pixabay.com/api/docs/
PEXELS_API_KEY=
PIXABAY_API_KEY=

# Signs the stock download proxy's links. Set it (any long random string) when running more than one server
# instance, or to keep links valid across restarts; otherwise a random secret is generated at startup.
STOCK_PROXY_SECRET=

# Features whose AI models are licensed for NON-COMMERCIAL use only: caption translation (NLLB-200), voice cloning
# (F5-TTS) and the RMBG-1.4 matting model. Leave unset (off) for any commercial deployment — including a free site
# run by a business — unless you hold commercial licenses from the model owners. See MODEL_LICENSES.md.
PUBLIC_ALLOW_NONCOMMERCIAL_MODELS=

# ---- Cloud AI (Phase 4) — see PHASE4_PLAN.md and supabase/README.md ----
# Server connection to the Supabase database as the least-privilege role `clipbench_server` (transaction pooler).
CLOUD_DATABASE_URL=
# The Supabase project's URL and publishable key (browser sign-in; the server verifies tokens with them).
PUBLIC_SUPABASE_URL=
PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Supabase secret key — only for uploads (voice, dubbing, lip sync). Server-only; never expose it.
SUPABASE_SECRET_KEY=
# Cloudflare Turnstile (bot check on cloud jobs). Dev test keys: 1x00000000000000000000AA / 1x0000000000000000000000000000000AA
PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# Unlocks /admin/spend (spend view, kill switch, global cap). Use a long random value.
CLOUD_ADMIN_TOKEN=
# Salt for hashing anonymous visitors' IPs (their credit key). Long random value; keep it stable.
ANON_KEY_SALT=
# Daily credits (defaults 50 signed in / 10 without an account) and jobs in flight per user (default 2).
CLOUD_DAILY_CREDITS=
CLOUD_DAILY_CREDITS_ANON=
CLOUD_MAX_ACTIVE_JOBS=
# "off" when a separate worker process runs the jobs (default: the web server runs them).
CLOUD_WORKER=
# Shows the development-only "Cloud check" feature.
PUBLIC_CLOUD_DEV_FEATURES=
# Contact address shown on the privacy and terms pages (and needed for the FFmpeg GPL source offer).
PUBLIC_CONTACT_EMAIL=
